entrypoint = "src/server.js"
run = "npm start"
modules = ["nodejs-20"]

[nix]
channel = "stable-24_05"

[env]
PORT = "8080"

[[ports]]
localPort = 8080
externalPort = 80

# Publish as a Reserved VM (web server). Autoscale stops the process when idle,
# which stops the background sampler.
# The published app keeps its data in SQLite on the VM (SENTINEL_DB=sqlite) instead
# of Replit's production Postgres, which is billed for every active hour.
[deployment]
build = ["npm", "ci", "--omit=dev"]
run = ["npm", "run", "start:sqlite"]
