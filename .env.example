# AgentSentinel configuration. Copy to .env for local runs; on Replit put these in Secrets.
# Only GATEWAY_SECRET, STATS_SECRET and DATABASE_URL matter in production; the rest have defaults.

# ---- Required in production ----
# Postgres connection string. Replit's PostgreSQL database sets this for you.
# Leave empty locally to use the SQLite file below.
DATABASE_URL=
# Shared secret the XDC AI gateway sends as "Authorization: Bearer <secret>".
# Paid routes reject calls without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GATEWAY_SECRET=
# Secret for the operator page: /stats?key=<STATS_SECRET>. Empty disables /stats.
STATS_SECRET=

# ---- Listing helper (npm run gateway / npm run gateway:import) ----
# Public https URL of this server, e.g. https://agentsentinel.replit.app
PUBLIC_BASE_URL=
# Optional: https://api.xdcai.tech/x402/connect/<serviceId>, shown in 401 bodies of paid routes.
GATEWAY_PUBLIC_URL=

# ---- Server ----
PORT=8080
# Local SQLite file used only when DATABASE_URL is empty (not persistent on Replit deployments).
SQLITE_PATH=./data/agentsentinel.sqlite
# Express "trust proxy" setting: number of proxy hops in front of the app (Replit: 1).
TRUST_PROXY=1

# ---- Sampling ----
SAMPLE_INTERVAL_SECONDS=15
# A value is reported stale when its sample is older than this or the last read failed.
STALE_AFTER_SECONDS=60
# Samples older than this are deleted (the newest sample of each series is always kept).
SAMPLE_RETENTION_HOURS=48
# Watches end (status expired) after this many days.
WATCH_TTL_DAYS=30
# Timeout for each external request.
SOURCE_TIMEOUT_MS=6000
# Longest time POST /watch waits for a first value of a series nobody samples yet.
CREATE_FETCH_WAIT_MS=4000

# ---- Data sources ----
# XDC mainnet JSON-RPC endpoints, tried in order (chain ID 50).
XDC_RPC_URLS=https://rpc.xinfin.network,https://erpc.xinfin.network,https://rpc.ankr.com/xdc,https://xdc.public-rpc.com
# XDC/USD price providers, tried in order: kraken, coingecko, coinpaprika.
PRICE_SOURCES=kraken,coingecko,coinpaprika
# Optional CoinGecko demo API key (higher rate limit). Works without one.
COINGECKO_API_KEY=

# ---- Limits ----
# Direct (non-gateway) requests per IP per minute.
RATE_LIMIT_IP_PER_MINUTE=120
# /check requests per watch token per minute (free token routes allow twice this).
RATE_LIMIT_TOKEN_PER_MINUTE=60
MAX_TOKENS_PER_REQUEST=50
MAX_ACTIVE_WATCHES=100000
MAX_WALLET_ADDRESSES=2000
MAX_TRIGGERS_PER_REPORT=20

# ---- Tests only ----
# Run the test suite against Postgres: TEST_DATABASE_URL=postgres://... npm run test:pg
TEST_DATABASE_URL=
